# Klipy API Key for GIF search (server-side)
# Get your key at: https://klipy.com/developers
# Note: Klipy is a drop-in replacement for Tenor (which shut down in 2026)
KLIPY_API_KEY=your_klipy_api_key_here

# Bonfire API URL (client-side)
# For local development, use http://localhost:3001
# For production, use your deployed API URL
VITE_BONFIRE_API_URL=http://localhost:3001
